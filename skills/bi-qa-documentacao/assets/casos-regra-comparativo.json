{
  "definir": {
    "'Vendas'[Faturado (Δ)]": "VAR vAV = [Faturado (AV)]\nVAR vAA = [Faturado (AA)]\nRETURN\n    IF ( NOT ISBLANK ( vAV ) && NOT ISBLANK ( vAA ), vAV - vAA )",
    "'Vendas'[Faturado (Δ%)]": "DIVIDE ( [Faturado (Δ)], ABS ( [Faturado (AA)] ) )",
    "'Vendas'[Faturado (Δi)]": "VAR vDelta = [Faturado (Δ)]\nRETURN\n    SWITCH (\n        TRUE (),\n        ISBLANK ( vDelta ), BLANK (),\n        vDelta > 0, \"✔️\",\n        vDelta = 0, \"⚠️\",\n        \"❗\"\n    )"
  },
